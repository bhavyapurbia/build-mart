NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173            # comma-separated allowlist for CORS
TRUST_PROXY=0

MONGODB_URI=                                # empty in dev → in-memory / local MongoDB
JWT_SECRET=                                 # >= 32 chars; REQUIRED in production
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
COOKIE_DOMAIN=

# Admin bootstrap (used only by: npm run create-admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=                             # >= 12 chars

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=                    # REQUIRED in production

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (SMTP)


# Optional
REDIS_URL=
SENTRY_DSN=
LOG_LEVEL=info

