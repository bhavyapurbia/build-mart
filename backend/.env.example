NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173,https://build-mart-7ly2.vercel.app,https://build-mart-1oze.onrender.com # comma-separated allowlist for CORS
TRUST_PROXY=0

MONGODB_URI=                                # empty in dev → in-memory / local MongoDB
JWT_SECRET=                                 # >= 32 chars; REQUIRED in production
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
COOKIE_DOMAIN=

# Admin bootstrap (used only by: npm run create-admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=                             # >= 12 chars

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=                    # REQUIRED in production

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Brevo HTTP API [Recommended for Render] / Brevo SMTP / Standard SMTP)
BREVO_API_KEY=                              # Recommended on Render (starts with xkeysib-..., uses HTTPS port 443)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
BREVO_FROM_EMAIL=support@buildplace.com     # Must be a verified sender in Brevo
BREVO_FROM_NAME=BuildPlace

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BuildPlace" <support@buildplace.com>


# Optional
REDIS_URL=
SENTRY_DSN=
LOG_LEVEL=info

