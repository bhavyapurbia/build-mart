# ========================================================
# BuildMart Monorepo .gitignore
# Covers Frontend (Vite/React) & Backend (Node/Express)
# ========================================================

# Dependencies
node_modules/
*/node_modules/
frontend/node_modules/
backend/node_modules/
package-lock.json.bak

# Production & Bundler Builds
dist/
*/dist/
frontend/dist/
build/
out/
.cache/
.vite/
frontend/.vite/

# Environment Variables & Secrets
.env
.env.*
*.env
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Backend Uploads & Temporary Storage
backend/public/temp/*
!backend/public/temp/.gitkeep
public/temp/*
!public/temp/.gitkeep
uploads/
tmp/
temp/

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids/
*.pid
*.seed
*.pid.lock

# Test & Code Coverage
coverage/
*.lcov
.nyc_output/

# Editor & OS Artifacts
.DS_Store
Thumbs.db
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.swp
*.swo

# AI & Audit Artifacts (Tools & Benchmark Snapshots)
.agents/
.hallmark/

# Backend JSON fallback data store (may contain emails, hashed passwords)
backend/src/data/
backend/data/
